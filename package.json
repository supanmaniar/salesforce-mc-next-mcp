{
  "name": "mc-next-mcp-server",
  "version": "1.0.0",
  "description": "MCP server exposing Salesforce Marketing Cloud Next, Data 360, and Data 360 Connect APIs, plus Salesforce platform tools (SOQL, describe, REST explorer, org limits). Catalogs generated from the official Postman collections.",
  "type": "module",
  "bin": {
    "mc-next-mcp-server": "dist/index.js"
  },
  "main": "dist/index.js",
  "author": {
    "name": "Supan Maniar",
    "url": "https://github.com/supanmaniar"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/supanmaniar/salesforce-mc-next-mcp.git"
  },
  "homepage": "https://github.com/supanmaniar/salesforce-mc-next-mcp#readme",
  "bugs": {
    "url": "https://github.com/supanmaniar/salesforce-mc-next-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "catalog",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "ROADMAP.md",
    "Dockerfile",
    "docker-compose.yml",
    ".env.example"
  ],
  "scripts": {
    "generate": "node scripts/generate-catalog.mjs",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "smoke": "node scripts/smoke-test.mjs",
    "audit": "node scripts/audit-catalog.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build && npm run audit",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "lint-staged": {
    "*.{ts,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agent",
    "llm-tool",
    "claude",
    "copilot",
    "salesforce",
    "marketing-cloud",
    "marketing-cloud-next",
    "marketing-automation",
    "data-360",
    "data360",
    "data-cloud",
    "data-360-connect",
    "cms",
    "soql",
    "crm"
  ],
  "license": "MIT"
}
