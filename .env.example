# ---------------------------------------------------------------------------
# Salesforce Marketing Cloud Next + Data 360 MCP Server
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your values.
# The server reads these from the process environment (it does NOT auto-load
# .env files -- use your MCP client's `env` block, or `node --env-file=.env`).
# ---------------------------------------------------------------------------

# --- Required: OAuth 2.0 client credentials -------------------------------
# From a Salesforce Connected App with OAuth enabled and the client-credentials
# flow permitted. Enable the scopes you need:
#   sfdc_cms_api        -> Marketing Cloud Next (Content/CMS)
#   cdp_query_api       -> Data 360 query
#   cdp_profile_api     -> Data 360 profile
#   cdp_ingest_api      -> Data 360 ingestion
SF_CLIENT_ID=your_connected_app_consumer_key
SF_CLIENT_SECRET=your_connected_app_consumer_secret

# --- Required: base URLs --------------------------------------------------
# Marketing Cloud Next API base, INCLUDING the /services/data/vXX suffix.
MC_NEXT_API_BASE_URL=https://my-org.my.salesforce.com/services/data/v66.0

# Data 360 tenant URL (the c360a host), no path suffix.
DATA360_TENANT_URL=https://my-tenant.c360a.salesforce.com

# Data 360 Connect API base, INCLUDING /services/data/vXX.
DATA360_CONNECT_BASE_URL=https://my-tenant.c360a.salesforce.com/services/data/v66.0

# --- Optional: Salesforce platform tools ----------------------------------
# Login host used for the OAuth token endpoint.
#   Production / dev org : https://login.salesforce.com
#   Sandbox              : https://test.salesforce.com
SF_LOGIN_URL=https://login.salesforce.com

# Instance URL used by the platform tools (SOQL, describe, REST explorer,
# limits). Defaults to the origin of MC_NEXT_API_BASE_URL when unset.
SF_INSTANCE_URL=https://my-org.my.salesforce.com

# Salesforce API version for the platform tools (default 66.0).
SF_API_VERSION=66.0

# --- Optional: behaviour --------------------------------------------------
# Request timeout in milliseconds (default 60000).
MC_NEXT_TIMEOUT_MS=60000

# Max retry attempts for 429 / 5xx responses (default 3).
MC_NEXT_MAX_RETRIES=3

# Set to "true" to allow DELETE and destructive actions (delete/remove/cancel/
# deactivate/unpublish). When false (default), those tools return a refusal.
MC_NEXT_ALLOW_DESTRUCTIVE=false

# Set to "true" to allow SCHEMA changes: creating/deleting custom objects and
# custom fields. Gated separately from MC_NEXT_ALLOW_DESTRUCTIVE because schema
# changes are much harder to reverse. When false (default), those tools refuse.
MC_NEXT_ALLOW_METADATA_CHANGES=false

# Set to "true" to log HTTP requests to stderr (never stdout).
MC_NEXT_DEBUG=false

# --- Optional: response cache ---------------------------------------------
# TTL for caching successful GET responses, in milliseconds (default 30000).
# Set to 0 to disable caching entirely. Only GETs are ever cached; writes and
# error responses never are. See docs/PERFORMANCE.md.
MC_NEXT_CACHE_TTL_MS=30000

# Maximum number of cached responses held in memory (default 500, LRU eviction).
MC_NEXT_CACHE_MAX_ENTRIES=500

# --- Optional: async job polling ------------------------------------------
# Defaults for the mcnext_poll_job tool. Per-call arguments override these.
MC_NEXT_POLL_INTERVAL_MS=2000
MC_NEXT_POLL_TIMEOUT_MS=120000

# --- Optional: HTTP transport (OFF by default) -----------------------------
# The server is stdio-only unless MC_NEXT_HTTP_ENABLED=true. Turning this on
# exposes every tool to whoever can reach the port, and all callers run as the
# SAME Salesforce integration user -- there is no per-user identity.
# Read docs/HTTP-DEPLOYMENT.md before enabling it.
#
# MC_NEXT_HTTP_ENABLED=true
# MC_NEXT_HTTP_PORT=3000
#
# Bind host. Defaults to 127.0.0.1 (loopback only). Binding 0.0.0.0 exposes the
# server to the network and REQUIRES MC_NEXT_HTTP_AUTH_TOKEN -- the server will
# refuse to start otherwise.
# MC_NEXT_HTTP_HOST=127.0.0.1
#
# Bearer token for the HTTP transport. Generate one with `openssl rand -hex 32`.
# Minimum 16 characters. Required for any non-loopback bind.
# MC_NEXT_HTTP_AUTH_TOKEN=
#
# Comma-separated allowed Host header values. Set this whenever you bind beyond
# loopback, to protect against DNS rebinding.
# MC_NEXT_HTTP_ALLOWED_HOSTS=mcp.internal.example.com
